
.library-page {
  width: min(1200px, 92%);
  margin: 35px auto 70px;
}

.library-hero {
  background: linear-gradient(120deg, #172554, #312e81, #581c87);
  border: 1px solid #475569;
  border-radius: 20px;
  padding: 50px 45px;
  color: white;
}

.hero-eyebrow {
  color: #c4b5fd;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 2px;
}

.library-hero h1 {
  font-size: clamp(2rem, 4vw, 3rem);
  margin: 14px 0;
  color: white;
}

.library-hero p {
  color: #ddd6fe;
  max-width: 520px;
  line-height: 1.7;
  margin-bottom: 25px;
}

.primary-button {
  background: #8b5cf6;
  color: white;
  border: none;
  border-radius: 10px;
  padding: 13px 22px;
  font-weight: 600;
  cursor: pointer;
}

.primary-button:hover {
  background: #7c3aed;
}

.library-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin: 28px 0 40px;
}

.stat-card {
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 15px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.stat-card span {
  color: #cbd5e1;
  font-size: 0.9rem;
}

.stat-card strong {
  font-size: 2.3rem;
  color: white;
}

.stat-card small {
  color: #94a3b8;
}

.collection-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-bottom: 25px;
}

.collection-header h2 {
  color: #f8fafc;
  margin: 0 0 8px;
}

.collection-header p {
  color: #94a3b8;
  margin: 0;
}

.collection-count {
  background: #312e81;
  color: #ddd6fe;
  padding: 8px 14px;
  border-radius: 20px;
  white-space: nowrap;
}

.games-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
  align-items: stretch;
}

.game-form-section {
  background: #1e293b;
  color: #f8fafc;
  border: 1px solid #334155;
  border-radius: 16px;
  padding: 30px;
  margin-top: 25px;
}

.game-form-section > p {
  color: #94a3b8;
}

.game-form-section form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 20px;
}

.game-form-section form > div {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.game-form-section label {
  font-weight: 500;
}

.game-form-section input,
.game-form-section select {
  width: 100%;
  box-sizing: border-box;
  padding: 12px;
  border-radius: 9px;
  border: 1px solid #475569;
  background: #0f172a;
  color: white;
}

.game-form-section form > button {
  grid-column: 1 / -1;
  background: #7c3aed;
  color: white;
  border: none;
  border-radius: 9px;
  padding: 14px;
  cursor: pointer;
}

.library-empty {
  text-align: center;
  padding: 70px 20px;
  background: #1e293b;
  border: 1px dashed #475569;
  border-radius: 16px;
}

.library-empty span {
  font-size: 3rem;
}

.library-empty h3 {
  color: white;
}

.library-empty p,
.library-message {
  color: #94a3b8;
}

.error-message {
  color: #fca5a5;
  margin: 15px 0;
}

@media (max-width: 900px) {
  .games-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .library-hero {
    padding: 30px 22px;
  }

  .library-stats,
  .games-grid,
  .game-form-section form {
    grid-template-columns: 1fr;
  }

  .collection-header {
    align-items: flex-start;
    flex-direction: column;
  }
}

/* ==========================
   NAVEGACIÓN
========================== */

.site-header {
  width: 100%;
  background: #111827;
  border-bottom: 1px solid #263244;
}

.site-nav {
  max-width: 1200px;
  margin: 0 auto;
  min-height: 76px;
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.site-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 1.5rem;
  font-weight: 800;
  color: white;
  letter-spacing: -0.5px;
}

.site-logo:hover {
  color: white;
}

.logo-icon {
  font-size: 1.8rem;
}

.logo-accent {
  color: #a78bfa;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 24px;
}

.nav-link {
  color: #cbd5e1;
  font-size: 0.95rem;
  font-weight: 500;
}

.nav-link.active {
  color: #a78bfa;
}

.nav-register,
.nav-logout {
  background: #7c3aed;
  color: white;
  border: none;
  padding: 11px 18px;
  border-radius: 9px;
  font-weight: 600;
  font-size: 0.9rem;
}

.nav-register:hover,
.nav-logout:hover {
  background: #6d28d9;
  color: white;
}

/* ==========================
   LOGIN Y REGISTRO
========================== */

.auth-page {
  min-height: calc(100vh - 76px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 50px 20px;
  background:
    radial-gradient(
      ellipse at 50% 20%,
      rgba(124, 58, 237, 0.14),
      transparent 60%
    ),
    #0b1120;
}

.auth-card {
  width: 100%;
  max-width: 450px;
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 20px;
  padding: 38px;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25);
}

.auth-heading {
  text-align: center;
  margin-bottom: 30px;
}

.auth-icon {
  font-size: 2.5rem;
  margin-bottom: 15px;
}

.auth-heading h1 {
  font-size: 1.8rem;
  margin: 0 0 12px;
  line-height: 1.3;
}

.auth-heading p {
  color: #94a3b8;
  font-size: 0.95rem;
  margin: 0;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.form-field label {
  font-size: 0.9rem;
  font-weight: 600;
  color: #e2e8f0;
}

.form-field input {
  width: 100%;
  padding: 13px 14px;
  background: #0f172a;
  border: 1px solid #475569;
  border-radius: 9px;
  color: white;
}

.form-field input::placeholder {
  color: #64748b;
}

.auth-submit {
  background: #7c3aed;
  color: white;
  border: none;
  border-radius: 9px;
  padding: 14px;
  font-weight: 700;
  margin-top: 5px;
}

.auth-submit:hover {
  background: #6d28d9;
}

.auth-footer {
  margin: 25px 0 0;
  text-align: center;
  color: #94a3b8;
  font-size: 0.9rem;
}

.auth-footer a {
  font-weight: 600;
}

@media (max-width: 600px) {
  .site-nav {
    padding: 12px 16px;
    flex-wrap: wrap;
  }

  .site-logo {
    font-size: 1.2rem;
  }

  .nav-links {
    gap: 12px;
  }

  .auth-card {
    padding: 26px 20px;
  }
}


/* Cuadrícula de videojuegos */
.games-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 24px;
  align-items: stretch;
}

/* Tarjeta individual */
.game-card {
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 16px;
  overflow: hidden;
  min-width: 0;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease;
}

.game-card:hover {
  transform: translateY(-4px);
}

/* Contenedor de portada */
.game-cover {
  width: 100%;
  height: 230px;
  background: #0f172a;
  overflow: hidden;
}

/* Imagen */
.game-cover img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Cuando no existe portada */
.game-cover-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #94a3b8;
}

.game-cover-placeholder span {
  font-size: 3rem;
}

/* Información */
.game-card-content {
  padding: 18px;
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 8px;
}

.game-card-content h3 {
  margin: 8px 0;
  font-size: 1.2rem;
  color: white;
}

.game-card-content p {
  margin: 0;
  color: #cbd5e1;
  font-size: 0.9rem;
}

/* Estados */
.game-status {
  align-self: flex-start;
  padding: 5px 12px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
}

.status-pendiente {
  background: #475569;
  color: white;
}

.status-jugando {
  background: #2563eb;
  color: white;
}

.status-completado {
  background: #059669;
  color: white;
}

/* Acciones */
.game-card-actions {
  display: flex;
  gap: 10px;
  margin-top: auto;
  padding-top: 16px;
}

.btn-details,
.btn-delete {
  flex: 1;
  text-align: center;
  padding: 10px;
  border-radius: 8px;
  font-size: 0.85rem;
  border: none;
  text-decoration: none;
}

.btn-details {
  background: #7c3aed;
  color: white;
}

.btn-delete {
  background: #7f1d1d;
  color: white;
}

@media (max-width: 600px) {
  .games-grid {
    grid-template-columns: 1fr;
  }
}
